wanthome
mkdir $WORK/private
mkdir $WORK/private/ssh
cp manifest $WORK/private/tuck.toml
exec tuck source add $WORK/private --no-color
exec tuck pkg list --source private --no-color
stdout 'source: private'
stdout 'ssh'
! stdout 'zsh'
! stderr .

-- manifest --
name = "private"
-- src/zsh/.zshrc --
# zshrc
