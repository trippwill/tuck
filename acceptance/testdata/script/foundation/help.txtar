# Help bypasses state discovery and exits successfully.
exec tuck --help
stdout 'USAGE'

exec tuck --help --json
stdout '"kind":"help"'

# No command shows top-level help and exits successfully.
exec tuck
stdout 'USAGE'

# A command group with no subcommand shows group help and exits successfully.
exec tuck package
stdout 'USAGE'

exec tuck source
stdout 'USAGE'

# Help is only a flag, not a command.
! exec tuck help
stderr 'Incorrect Usage'
stderr 'unknown command'
