# help bypasses state discovery and exits successfully
phase help
exec tuck --help
stdout 'USAGE'

exec tuck --help --json
stdout '"kind":"help"'
stdout '"command":"tuck"'

# representative leaf command help includes scoped arguments and flags
phase leaf-help
exec tuck status --help
stdout 'tuck status'
stdout 'USAGE'
stdout '<file>'
stdout '--source'
stdout '--root'
! stderr .

exec tuck package use --help
stdout 'tuck package use'
stdout 'USAGE'
stdout '<package>...'
stdout '--apply'
stdout '--all'
! stderr .

exec tuck source add --help
stdout 'tuck source add'
stdout 'USAGE'
stdout '<path>'
stdout '--default'
stdout '--init'
! stderr .

# JSON help is available for command groups, leaves, and aliases
phase json-help
exec tuck --json package --help
stdout '"command":"package"'
stdout '"kind":"help"'
stdout '"name":"tuck package"'
stdout '"commands":\['
! stderr .

exec tuck package use --help --json
stdout '"command":"package use"'
stdout '"kind":"help"'
stdout '"name":"tuck package use"'
stdout '"argsUsage":"<package>..."'
stdout '"globalFlags":\['
! stderr .

exec tuck pkg ls --help --json
stdout '"command":"package list"'
stdout '"kind":"help"'
stdout '"aliases":\["ls"\]'
! stderr .

# no command shows top-level help and exits successfully
phase no-command
exec tuck
stdout 'USAGE'

# command groups with no subcommand show group help and exit successfully
phase command-group-help
exec tuck package
stdout 'USAGE'

exec tuck source
stdout 'USAGE'

# help is only a flag, not a command
phase help-is-not-command
! exec tuck help
stderr 'Incorrect Usage'
stderr 'unknown command'

# unknown commands are CLI parse/dispatch errors
phase unknown-command
! exec tuck definitely-not-a-command
stderr 'Incorrect Usage'
stderr 'unknown command'

# unknown nested commands behave the same way
phase unknown-nested-command
! exec tuck source definitely-not-a-source-command
stderr 'Incorrect Usage'
stderr 'unknown command'

! exec tuck package definitely-not-a-pkg-command
stderr 'Incorrect Usage'
stderr 'unknown command'

# unknown flags use urfave/cli's default parse-error output
phase unknown-flag
! exec tuck --bogus
stderr 'Incorrect Usage'
stderr 'flag provided'

# urfave/cli provides the version flag and output format
phase version
exec tuck --version
stdout 'tuck version dev'

exec tuck -v
stdout 'tuck version dev'

exec tuck --version --json
stdout '"kind":"version"'
stdout '"version":"dev"'
