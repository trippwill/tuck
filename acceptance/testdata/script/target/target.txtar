# status reports source and root errors
phase status-errors fixtures/target/status/common
! exec tuck status $WORK/home/missing --no-color
stderr 'no active source'
wantstate public public $WORK/src true
mkdir $WORK/root
env TUCK_TEST_ROOT_DIR=$WORK/root
exec tuck --root status /etc/hosts --no-color
stdout 'context: root'
stdout 'absent'
stdout '/etc/hosts'
exec tuck status --root /etc/hosts --no-color
stdout 'context: root'
stdout 'absent'
stdout '/etc/hosts'
exec tuck status /usr/local/bin/tool --no-color
stdout 'outside_target_root'
stdout 'pass --root'
exec tuck --json status /usr/local/bin/tool
stdout '"code":"outside_target_root"'

# file status classifies absent, unmanaged, and mismatched targets
phase status-file-absent-unmanaged-mismatch fixtures/target/status/common
wantstate public public $WORK/src true
exec tuck status $WORK/home/.config/zsh/missing --no-color
stdout 'absent'
exec tuck stat $WORK/home/.config/zsh/missing --no-color
stdout 'absent'
mkdir $WORK/home/.config
mkdir $WORK/home/.config/other
symlink $WORK/home/.config/other/link -> ../outside
exec tuck status $WORK/home/.config/other/link --no-color
stdout 'unmanaged'
mkdir $WORK/home/wrong
symlink $WORK/home/wrong/.zshrc -> ../../src/zsh/.config/zsh/.zshrc
exec tuck status $WORK/home/wrong/.zshrc --no-color
stdout 'mismatch'
stdout 'public:home:zsh'
! stderr .

# file status emits the status JSON envelope
phase status-file-json fixtures/target/status/common
wantstate public public $WORK/src true
exec tuck pkg use zsh --apply --no-color
exec tuck --json status $WORK/home/.config/zsh/.zshrc
stdout '"schemaVersion":1'
stdout '"command":"status"'
stdout '"context":"home"'
stdout '"kind":"status"'
stdout '"entries":\['
stdout '"state":"deployed"'
stdout 'public:home:zsh'
stdout '"exitCode":0'
! stderr .

# file status reports a managed deployed symlink in human output
phase status-file-managed fixtures/target/status/common
wantstate public public $WORK/src true
exec tuck pkg use zsh --apply --no-color
exec tuck status $WORK/home/.config/zsh/.zshrc --no-color
stdout 'tuck status'
stdout 'deployed'
stdout 'public:home:zsh'
stdout '.config/zsh/.zshrc'
! stderr .

# root target operations use logical paths while reading and writing the physical test root
phase root-target-operations fixtures/target/status/common fixtures/target/root/common
wantstate public public $WORK/src true
mkdir $WORK/root
mkdir $WORK/root/etc
mkdir $WORK/root/etc/ssh
env TUCK_TEST_ROOT_DIR=$WORK/root
env TUCK_TEST_PRIVILEGE=granted
symlink $WORK/root/etc/ssh/sshd_config -> ../../../src/.root/sshd/etc/ssh/sshd_config
exec tuck status --root /etc/ssh/sshd_config --no-color
stdout 'context: root'
stdout 'deployed'
stdout 'public:root:sshd'
stdout '/etc/ssh/sshd_config'
! stdout $WORK/root
cp fixtures/target/adopt/root.conf $WORK/root/etc/tuck.conf
exec tuck adopt --root /etc/tuck.conf sys --apply --no-color
stdout 'context: root, apply'
stdout 'public:root:sys'
stdout '/etc/tuck.conf'
! stdout $WORK/root
readlink $WORK/root/etc/tuck.conf ../../src/.root/sys/etc/tuck.conf
exists $WORK/src/.root/sys/etc/tuck.conf
exec tuck eject --root /etc/tuck.conf --apply --no-color
stdout 'context: root, apply'
stdout 'public:root:sys'
exists $WORK/root/etc/tuck.conf
! exists $WORK/src/.root/sys/etc/tuck.conf
cmp $WORK/root/etc/tuck.conf fixtures/target/adopt/root.conf
! stderr .

# top-level status usage validation is target-command-specific
phase status-usage fixtures/target/status/common
wantstate public public $WORK/src true
! exec tuck status --no-color
stderr 'Incorrect Usage'
! exec tuck status one two --no-color
stderr 'status accepts exactly one <file>'

# adopt dry-run prints a move/link plan and does not mutate
phase adopt-dry-run fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/nvim
cp fixtures/target/adopt/init.lua $WORK/home/.config/nvim/init.lua
exec tuck adopt $WORK/home/.config/nvim/init.lua nvim --no-color
stdout 'tuck adopt nvim'
stdout 'context: home, dry-run'
stdout 'packages: public:home:nvim'
stdout 'plan:'
stdout '\+ mkdir'
stdout '\+ move'
stdout '\+ link'
stdout '3 actions, 0 conflicts'
stdout 're-run with --apply to execute'
exists $WORK/home/.config/nvim/init.lua
! exists $WORK/src/nvim/.config/nvim/init.lua
! stderr .

# adopt --apply moves a file into a new package and links it back
phase adopt-apply-new-package fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/nvim
cp fixtures/target/adopt/init.lua $WORK/home/.config/nvim/init.lua
exec tuck adopt $WORK/home/.config/nvim/init.lua nvim --apply --no-color
stdout 'context: home, apply'
stdout '3 actions, 0 conflicts'
readlink $WORK/home/.config/nvim/init.lua ../../../src/nvim/.config/nvim/init.lua
exists $WORK/src/nvim/.config/nvim/init.lua
! stderr .

# adopt --copy creates per-file copy config and a copied target
phase adopt-copy fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/nvim
cp fixtures/target/adopt/init.lua $WORK/home/.config/nvim/init.lua
exec tuck adopt --copy $WORK/home/.config/nvim/init.lua nvim --no-color
stdout '\+ move'
stdout '\+ copy'
stdout '\+ config'
stdout '4 actions, 0 conflicts'
exists $WORK/home/.config/nvim/init.lua
! exists $WORK/src/nvim/.tuck.toml
exec tuck adopt --copy $WORK/home/.config/nvim/init.lua nvim --apply --no-color
stdout '\+ copy'
stdout '\+ config'
stdout '4 actions, 0 conflicts'
exists $WORK/home/.config/nvim/init.lua
! exec test -L $WORK/home/.config/nvim/init.lua
exists $WORK/src/nvim/.config/nvim/init.lua
grep 'deploy = "copy"' $WORK/src/nvim/.tuck.toml
exec tuck status $WORK/home/.config/nvim/init.lua --no-color
stdout 'deployed'
stdout 'public:home:nvim'
! exec tuck adopt --mode 0600 $WORK/home/.config/nvim/init.lua nvim --no-color
stderr 'adopt --mode requires --copy'

# adopt --copy --mode accepts chmod-style expressions and writes normalized octal mode
phase adopt-copy-mode fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/nvim
cp fixtures/target/adopt/init.lua $WORK/home/.config/nvim/init.lua
exec tuck adopt --copy --mode u=rw,go= $WORK/home/.config/nvim/init.lua nvim --apply --no-color
stdout 'mode=0600'
grep 'mode = "0600"' $WORK/src/nvim/.tuck.toml
exec stat -c %a $WORK/home/.config/nvim/init.lua
stdout '600'
! stderr .

# adopt can add a new leaf to an existing package
phase adopt-existing-package fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
cp fixtures/target/adopt/zprofile $WORK/home/.config/zsh/.zprofile
exec tuck adopt $WORK/home/.config/zsh/.zprofile zsh --apply --no-color
stdout 'public:home:zsh'
stdout '3 actions, 0 conflicts'
readlink $WORK/home/.config/zsh/.zprofile ../../../src/zsh/.config/zsh/.zprofile
exists $WORK/src/zsh/.config/zsh/.zprofile
! stderr .

# adopt emits the plan JSON envelope
phase adopt-json fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/nvim
cp fixtures/target/adopt/init.lua $WORK/home/.config/nvim/init.lua
exec tuck --json adopt $WORK/home/.config/nvim/init.lua nvim
stdout '"schemaVersion":1'
stdout '"command":"adopt"'
stdout '"context":"home"'
stdout '"kind":"plan"'
stdout '"dryRun":true'
stdout '"applied":false'
stdout 'public:home:nvim'
stdout '"type":"move"'
stdout '"src":"'$WORK'/home/.config/nvim/init.lua"'
stdout '"dst":"'$WORK'/src/nvim/.config/nvim/init.lua"'
stdout '"type":"symlink"'
stdout '"conflicts":\[\]'
stdout '"exitCode":0'
exists $WORK/home/.config/nvim/init.lua
! exists $WORK/src/nvim/.config/nvim/init.lua
! stderr .

# adopt --copy emits copy and config actions in JSON
phase adopt-copy-json fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/nvim
cp fixtures/target/adopt/init.lua $WORK/home/.config/nvim/init.lua
exec tuck --json adopt --copy $WORK/home/.config/nvim/init.lua nvim
stdout '"command":"adopt"'
stdout '"kind":"plan"'
stdout '"type":"move"'
stdout '"type":"copy"'
stdout '"type":"package_config"'
stdout '"path":"'$WORK'/src/nvim/.tuck.toml"'
stdout '"exitCode":0'
! exists $WORK/src/nvim/.tuck.toml
! stderr .

phase adopt-copy-mode-json fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/nvim
cp fixtures/target/adopt/init.lua $WORK/home/.config/nvim/init.lua
exec tuck --json adopt --copy --mode u=rw,go= $WORK/home/.config/nvim/init.lua nvim
stdout '"type":"copy"'
stdout '"mode":"0600"'
stdout '"type":"package_config"'
stdout '"exitCode":0'
! stderr .

# adopt reports target and package-path conflicts without mutating
phase adopt-conflicts fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/nvim
mkdir $WORK/home/.config/nvim/init.lua
! exec tuck adopt $WORK/home/.config/nvim/init.lua nvim --apply --no-color
stdout 'conflicts:'
stdout 'real_directory'
stdout '0 actions, 1 conflicts'
mkdir $WORK/home/.config/zsh
cp fixtures/target/adopt/zprofile $WORK/home/.config/zsh/.zshrc
! exec tuck adopt $WORK/home/.config/zsh/.zshrc zsh --apply --no-color
stdout 'package_path_exists'
stdout '0 actions, 1 conflicts'
exists $WORK/home/.config/zsh/.zshrc
exists $WORK/src/zsh/.config/zsh/.zshrc
! stderr .

# adopt rejects files inside an enabled source repository
phase adopt-inside-source fixtures/target/status/common
exec cp -R $WORK/src $WORK/home/.dotfiles
wantstate public public $WORK/home/.dotfiles true
! exec tuck adopt $WORK/home/.dotfiles/zsh/.config/zsh/.zshrc zsh --no-color
stdout 'inside_source_repo'
stdout '0 actions, 1 conflicts'
exists $WORK/home/.dotfiles/zsh/.config/zsh/.zshrc
! stderr .

# adopt reports source/ref errors and usage validation
phase adopt-errors fixtures/target/status/common
! exec tuck adopt $WORK/home/file nvim --no-color
stderr 'no active source'
wantstate public public $WORK/src true
! exec tuck adopt --no-color
stderr 'Incorrect Usage'
! exec tuck adopt one --no-color
stderr 'Incorrect Usage'
! exec tuck adopt one two three --no-color
stderr 'adopt accepts exactly <file> <package>'
! exec tuck adopt $WORK/home/file bad/ref --no-color
stderr 'error: invalid package ref "bad/ref"'
! exec tuck adopt --source missing $WORK/home/file nvim --no-color
stderr 'source is not enabled'

# eject dry-run prints an unlink/move plan and does not mutate
phase eject-dry-run fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh/.zshrc -> ../../../src/zsh/.config/zsh/.zshrc
exec tuck eject $WORK/home/.config/zsh/.zshrc --no-color
stdout 'tuck eject zsh'
stdout 'context: home, dry-run'
stdout 'packages: public:home:zsh'
stdout 'plan:'
stdout '- unlink'
stdout '\+ move'
stdout '- rmdir'
stdout '4 actions, 0 conflicts'
stdout 're-run with --apply to execute'
readlink $WORK/home/.config/zsh/.zshrc ../../../src/zsh/.config/zsh/.zshrc
exists $WORK/src/zsh/.config/zsh/.zshrc
exists $WORK/src/zsh/.config/zsh
exists $WORK/src/zsh/.config
exists $WORK/src/zsh
! stderr .

# eject --apply removes the managed symlink and restores the real target file
phase eject-apply fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh/.zshrc -> ../../../src/zsh/.config/zsh/.zshrc
exec tuck eject $WORK/home/.config/zsh/.zshrc --apply --no-color
stdout 'context: home, apply'
stdout '4 actions, 0 conflicts'
exists $WORK/home/.config/zsh/.zshrc
! exists $WORK/src/zsh/.config/zsh/.zshrc
! exists $WORK/src/zsh/.config/zsh
! exists $WORK/src/zsh/.config
exists $WORK/src/zsh
cmp $WORK/home/.config/zsh/.zshrc fixtures/target/status/common/zsh/.config/zsh/.zshrc
! stderr .

# eject emits the plan JSON envelope
phase eject-json fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh/.zshrc -> ../../../src/zsh/.config/zsh/.zshrc
exec tuck --json eject $WORK/home/.config/zsh/.zshrc
stdout '"schemaVersion":1'
stdout '"command":"eject"'
stdout '"context":"home"'
stdout '"kind":"plan"'
stdout '"dryRun":true'
stdout '"applied":false'
stdout 'public:home:zsh'
stdout '"type":"remove_symlink"'
stdout '"type":"move"'
stdout '"src":"'$WORK'/src/zsh/.config/zsh/.zshrc"'
stdout '"dst":"'$WORK'/home/.config/zsh/.zshrc"'
stdout '"type":"rmdir"'
stdout '"path":"'$WORK'/src/zsh/.config/zsh"'
stdout '"path":"'$WORK'/src/zsh/.config"'
stdout '"exitCode":0'
readlink $WORK/home/.config/zsh/.zshrc ../../../src/zsh/.config/zsh/.zshrc
! stderr .

# eject preserves source directories that still contain sibling leaves
phase eject-preserves-sibling-leaf fixtures/target/status/common fixtures/target/eject/sibling-leaf
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh/.zshrc -> ../../../src/zsh/.config/zsh/.zshrc
exec tuck eject $WORK/home/.config/zsh/.zshrc --apply --no-color
stdout '2 actions, 0 conflicts'
! stdout 'rmdir'
exists $WORK/src/zsh/.config/zsh
exists $WORK/src/zsh/.config/zsh/.zprofile
! stderr .

# eject preserves source directories that still contain extra entries
phase eject-preserves-extra-entry fixtures/target/status/common fixtures/target/eject/extra-entry
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh/.zshrc -> ../../../src/zsh/.config/zsh/.zshrc
exec tuck eject $WORK/home/.config/zsh/.zshrc --apply --no-color
stdout '2 actions, 0 conflicts'
! stdout 'rmdir'
exists $WORK/src/zsh/.config/zsh
exists $WORK/src/zsh/.config/zsh/plugins
! stderr .

# eject infers ownership only in the active source and honors --source
phase eject-active-source fixtures/target/status/common
wantstate public public $WORK/src true private $WORK/fixtures/target/eject/private-source true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh/.zshrc -> $WORK/fixtures/target/eject/private-source/zsh/.config/zsh/.zshrc
! exec tuck eject $WORK/home/.config/zsh/.zshrc --no-color
stdout 'not_a_managed_symlink'
stdout '0 actions, 1 conflicts'
exec tuck eject --source private $WORK/home/.config/zsh/.zshrc --no-color
stdout 'packages: private:home:zsh'
stdout '4 actions, 0 conflicts'
! stderr .

# eject reports unmanaged links, mismatches, and invalid package payloads
phase eject-conflicts fixtures/target/status/common
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh/.zlogin -> ../../unmanaged
! exec tuck eject $WORK/home/.config/zsh/.zlogin --no-color
stdout 'not_a_managed_symlink'
stdout '0 actions, 1 conflicts'
mkdir $WORK/home/wrong
symlink $WORK/home/wrong/.zshrc -> ../../src/zsh/.config/zsh/.zshrc
! exec tuck eject $WORK/home/wrong/.zshrc --no-color
stdout 'path_mismatch'
stdout '0 actions, 1 conflicts'
symlink $WORK/home/.config/zsh/missing -> ../../../src/zsh/.config/zsh/missing
! exec tuck eject $WORK/home/.config/zsh/missing --no-color
stdout 'package file does not exist'
stdout '0 actions, 1 conflicts'
rm $WORK/home/.config/zsh/missing
rm $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh -> ../../src/zsh/.config/zsh
! exec tuck eject $WORK/home/.config/zsh --no-color
stdout 'package path is a directory'
stdout '0 actions, 1 conflicts'
! stderr .

# eject reports usage validation
phase eject-errors fixtures/target/status/common
wantstate public public $WORK/src true
! exec tuck eject --no-color
stderr 'Incorrect Usage'
! exec tuck eject one two --no-color
stderr 'eject accepts exactly one <file>'

# adopt and eject are copy-aware for tracked copied files
phase copy-adopt-eject fixtures/target/copy/common
wantstate public public $WORK/src true
exec tuck pkg use app --apply --no-color
cp fixtures/target/copy/target-v2 $WORK/home/.config/app/config
exec tuck adopt $WORK/home/.config/app/config app --apply --no-color
stdout '\+ copy'
stdout '2 actions, 0 conflicts'
cmp $WORK/src/app/.config/app/config fixtures/target/copy/target-v2
exec tuck eject $WORK/home/.config/app/config --apply --no-color
stdout '- track'
stdout '- file'
exists $WORK/home/.config/app/config
! exists $WORK/src/app/.config/app/config
cmp $WORK/home/.config/app/config fixtures/target/copy/target-v2
! stderr .

-- fixtures/target/status/common/.tuck.toml --
name = "public"
-- fixtures/target/status/common/zsh/.config/zsh/.zshrc --
# zshrc
-- fixtures/target/adopt/init.lua --
vim.o.number = true
-- fixtures/target/adopt/root.conf --
root=true
-- fixtures/target/adopt/zprofile --
# zprofile
-- fixtures/target/root/common/.root/sshd/etc/ssh/sshd_config --
# sshd
-- fixtures/target/eject/private-source/.tuck.toml --
name = "private"
-- fixtures/target/eject/private-source/zsh/.config/zsh/.zshrc --
# private zshrc
-- fixtures/target/eject/sibling-leaf/zsh/.config/zsh/.zprofile --
# zprofile
-- fixtures/target/eject/extra-entry/zsh/.config/zsh/plugins/README --
plugins
-- fixtures/target/copy/common/.tuck.toml --
name = "public"
-- fixtures/target/copy/common/app/.config/app/config --
source-v1
-- fixtures/target/copy/common/app/.tuck.toml --
[[file]]
path = ".config/app/config"
deploy = "copy"
-- fixtures/target/copy/target-v2 --
target-v2
