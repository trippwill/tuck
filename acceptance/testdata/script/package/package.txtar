# package use --all applies only non-hidden home packages
phase package-use-all fixtures/package/common/public-only fixtures/package/common/zsh-config fixtures/package/common/hidden-root fixtures/package/use/all
wantstate public public $WORK/src true
exec tuck pkg use --all --apply --no-color
stdout 'public:home:git'
stdout 'public:home:zsh'
! stdout 'public:home:\.hidden'
exists $WORK/home/.gitconfig
exists $WORK/home/.config/zsh/.zshrc
! exists $WORK/home/root-only
! exists $WORK/home/secret
! stderr .

# package use --apply creates directories and relative symlinks
phase package-use-apply fixtures/package/common/public-only fixtures/package/common/zsh-config
wantstate public public $WORK/src true
exec tuck pkg use zsh --apply --no-color
stdout 'context: home, apply'
stdout '2 actions, 0 conflicts'
exists $WORK/home/.config/zsh
exists $WORK/home/.config/zsh/.zshrc
readlink $WORK/home/.config/zsh/.zshrc ../../../src/zsh/.config/zsh/.zshrc
! stderr .

# package root context lists, plans, applies, statuses, and drops .root packages with logical paths
phase package-root-context fixtures/package/common/public-only fixtures/package/common/root-sshd
wantstate public public $WORK/src true
mkdir $WORK/root
env TUCK_TEST_ROOT_DIR=$WORK/root
env TUCK_TEST_PRIVILEGE=granted
exec tuck pkg list --root --no-color
stdout 'context: root'
stdout 'sshd'
! stdout 'zsh'
exec tuck pkg use sshd --root --no-color
stdout 'context: root, dry-run'
stdout '/etc/ssh/sshd_config'
! stdout $WORK/root
! exists $WORK/root/etc/ssh/sshd_config
exec tuck pkg use sshd --root --apply --no-color
stdout 'context: root, apply'
stdout '/etc/ssh/sshd_config'
readlink $WORK/root/etc/ssh/sshd_config ../../../src/.root/sshd/etc/ssh/sshd_config
exec tuck pkg status sshd --root --no-color
stdout 'public:root:sshd'
stdout 'deployed'
stdout '/etc/ssh/sshd_config'
exec tuck pkg drop sshd --root --apply --no-color
stdout 'context: root, apply'
! exists $WORK/root/etc/ssh/sshd_config
exists $WORK/root/etc/ssh
! stderr .

# package root context requires privilege for apply but not dry-run
phase package-root-privilege fixtures/package/common/public-only fixtures/package/common/root-sshd
wantstate public public $WORK/src true
mkdir $WORK/root
env TUCK_TEST_ROOT_DIR=$WORK/root
env TUCK_TEST_PRIVILEGE=denied
exec tuck pkg use sshd --root --no-color
stdout 'context: root, dry-run'
stdout '/etc/ssh/sshd_config'
! exists $WORK/root/etc/ssh/sshd_config
! exec tuck pkg use sshd --root --apply --no-color
stdout 'context: root, apply'
stdout '/etc/ssh/sshd_config'
stdout 'privilege required: root-context write'
! stderr .
! exists $WORK/root/etc/ssh/sshd_config
! exec tuck --json pkg use sshd --root --apply
stdout '"schemaVersion":1'
stdout '"command":"package use"'
stdout '"context":"root"'
stdout '"kind":"plan"'
stdout '"privilege":{"required":true,"satisfied":false,"reason":"root-context write"}'
stdout '"exitCode":1'

# package use accumulates directory and real-file conflicts
phase package-use-conflicts fixtures/package/common/public-only fixtures/package/common/zsh-config fixtures/package/use/conflicts
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
mkdir $WORK/home/.config/zsh/.zshrc
cp fixtures/package/common/existing-file $WORK/home/.config/zsh/dirfile
! exec tuck pkg use zsh --no-color
stdout 'conflicts:'
stdout 'real_file'
stdout 'real_directory'
stdout '0 actions, 2 conflicts'
exists $WORK/home/.config/zsh/.zshrc
! stderr .

# package use dry-run prints a plan and does not mutate
phase package-use-dry-run fixtures/package/common/public-only fixtures/package/common/zsh-config
wantstate public public $WORK/src true
exec tuck pkg use zsh --no-color
stdout 'context: home, dry-run'
stdout 'plan:'
stdout '\+ mkdir'
stdout '\+ link'
stdout '2 actions, 0 conflicts'
stdout 're-run with --apply to execute'
! exists $WORK/home/.config/zsh/.zshrc
! stderr .

# package use is idempotent for an already selected managed link
phase package-use-idempotent fixtures/package/common/public-only fixtures/package/common/zsh-config
wantstate public public $WORK/src true
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
symlink $WORK/home/.config/zsh/.zshrc -> ../../../src/zsh/.config/zsh/.zshrc
exec tuck pkg use zsh --apply --no-color
stdout '0 actions, 0 conflicts'
readlink $WORK/home/.config/zsh/.zshrc ../../../src/zsh/.config/zsh/.zshrc
! stderr .

# invalid package refs fail before package resolution
phase package-use-invalid-ref fixtures/package/common/public-only
wantstate public public $WORK/src true
! exec tuck pkg use ../zsh --no-color
stderr 'error: invalid package ref "../zsh"'
stderr 'hint: pass a plain package name'
! stdout .
! exec tuck pkg use .hidden --no-color
stderr 'error: invalid package ref ".hidden"'
stderr 'hint: pass a plain package name'
! stdout .

# package use emits the plan JSON envelope
phase package-use-json fixtures/package/common/public-only fixtures/package/common/zsh-config
wantstate public public $WORK/src true
exec tuck --json pkg use zsh
stdout '"schemaVersion":1'
stdout '"command":"package use"'
stdout '"context":"home"'
stdout '"kind":"plan"'
stdout '"dryRun":true'
stdout '"applied":false'
stdout 'public:home:zsh'
stdout '"type":"mkdir"'
stdout '"type":"symlink"'
stdout '"conflicts":\[\]'
stdout '"exitCode":0'
! exists $WORK/home/.config/zsh/.zshrc
! stderr .

# missing packages are classified as package_not_found
phase package-use-missing-package fixtures/package/common/public-only fixtures/package/common/zsh-config
wantstate public public $WORK/src true
! exec tuck pkg use missing --no-color
stderr 'error: package "missing" not found in source "public"'
stderr 'hint: run tuck pkg list'
! stdout .

# multiple packages cannot provide the same target
phase package-use-multiple-providers fixtures/package/common/public-only fixtures/package/common/zsh-config fixtures/package/common/zsh-alt
wantstate public public $WORK/src true
! exec tuck pkg use zsh zsh-alt --no-color
stdout 'multiple_providers'
stdout '0 actions, 1 conflicts'
! exists $WORK/home/.config/zsh/.zshrc
! stderr .

# package use requires refs or --all, but not both
phase package-use-usage fixtures/package/common/public-only
wantstate public public $WORK/src true
! exec tuck pkg use --no-color
stderr 'error: package use requires one or more package refs or --all'
! stdout .
! exec tuck pkg use zsh --all --no-color
stderr 'error: package use accepts package refs or --all, not both'
! stdout .
! exec tuck --apply pkg use zsh --no-color
stderr 'flag provided but not defined: -apply'
stdout 'GLOBAL OPTIONS'

