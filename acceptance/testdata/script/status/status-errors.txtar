! exec tuck status $WORK/home/missing --no-color
stderr 'no active source'
wanthome
! exec tuck pkg status bad/ref --no-color
stderr 'invalid'
! exec tuck pkg status missing --no-color
stderr 'not found'
! exec tuck status --root /etc/hosts --no-color
stderr 'root'

-- src/zsh/.config/zsh/.zshrc --
# zshrc
