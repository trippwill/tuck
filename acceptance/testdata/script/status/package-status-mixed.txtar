wanthome
mkdir $WORK/home/.config
mkdir $WORK/home/.config/zsh
exec ln -s ../../../src/zsh/.config/zsh/.zshrc $WORK/home/.config/zsh/.zshrc
cp existing $WORK/home/.config/zsh/.zprofile
exec tuck pkg status zsh --no-color
stdout 'tuck package status'
stdout 'public:home:zsh'
stdout 'deployed'
stdout 'absent'
stdout 'conflict'
stdout 'real_file'
! stderr .

-- existing --
existing
-- src/zsh/.config/zsh/.zshrc --
# zshrc
-- src/zsh/.config/zsh/.zprofile --
# zprofile
-- src/zsh/.config/zsh/.zlogin --
# zlogin
